
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    @{Html.RenderPartial("~/Views/Shared/_PartialHeadPage.cshtml");}
    <title>Index</title>
    <style>
        .fitem {
            padding-left: 10px;
        }
    </style>
</head>
<body>
    <div>
        <!-- 数据表格容器 -->
        <table id="dg" class="easyui-datagrid" title="商品等级类型管理"
               style="width:99%;height:500px"
               toolbar="#toolbar" pagination="true"
               rownumbers="true" fitColumns="true">
            <thead>
                <tr>
                    <th field="Id" width="20">Id</th>
                    <th field="TypeFlag" hidden="hidden">工种编号</th>
                    <th field="TypeName" width="20">工种名称</th>
                    <th field="CompletionRate" width="20" formatter="formatPercentage">完成率</th>
                    <th field="WorkResult" width="20" >评议等级</th>
                    <th field="LevelName" width="20">商品等级</th>
                    <th field="JfUseMaxPoints" width="15" formatter="formatCurrency">月可用积分</th>
                    <th field="MonthCount" width="30">消费月份</th>
                    <th field="Remark" width="25">备注</th>
                    <th field="UseType" width="25" formatter="formatStatus">消费类型</th>
                    <th field="CrtBy" width="20">创建人</th>
                    <th field="CreateDate" width="20" formatter="formatDateTime">创建时间</th>
                    <th field="ModBy" width="20">最后修改人</th>
                    <th field="ModifyDate" width="20" formatter="formatDateTime">最后修改时间</th>
                </tr>
            </thead>
        </table>

        <!-- 工具栏 -->
        <div id="toolbar">
            <a href="javascript:void(0)" class="easyui-linkbutton" iconCls="icon-add" onclick="newItem()">新建</a>
            <a href="javascript:void(0)" class="easyui-linkbutton" iconCls="icon-edit" onclick="editItem()">编辑</a>
            <a href="javascript:void(0)" class="easyui-linkbutton" iconCls="icon-remove" onclick="destroyItem()">删除</a>
            <input id="searchbox" class="easyui-searchbox" style="width:200px" prompt="搜索..." />
        </div>

        <!-- 编辑对话框 -->
        <div id="dlg" class="easyui-dialog" style="width:400px" closed="true" buttons="#dlg-buttons">
            <form id="fm" method="post">
                <div class="fitem">
                    <label>消费类型:</label>
                    <select id="editUseType" name="UseType" style="width:150px" class="easyui-combobox" required="true">
                        <option value="0" selected="selected">消费系统</option>
                        <option value="1">积分系统</option>
                    </select>
                </div>
                <div class="fitem">
                    <label>类型名称:</label>
                    <select id="typeFlag" name="TypeFlag" style="width:150px" class="easyui-combobox" required="true">
                        @if (ViewData["workTypes"] != null)
                        {
                            foreach (var item in ViewData["workTypes"] as List<SelfhelpOrderMgr.Model.T_JF_DictCode>)
                            {
                                <option value="@item.FCode">@item.FName</option>
                            }
                        }
                    </select>
                    <input type="hidden" id="typeName" name="TypeName" value="" />
                </div>
                <div class="fitem">
                    <label>完成率:</label>
                    <input name="CompletionRate" class="easyui-validatebox" value="0" />
                </div>
                <div class="fitem">
                    <label>评议等级:</label>
                    <select id="workResult" name="WorkResult" style="width:150px" class="easyui-combobox">
                        <option value="">请选择</option>
                        @if (ViewData["workResults"] != null)
                        {
                            foreach (var item in ViewData["workResults"] as List<SelfhelpOrderMgr.Model.T_JF_DictCode>)
                            {
                                <option value="@item.FName">@item.FName</option>
                            }
                        }
                    </select>
                </div>
                <div class="fitem">
                    <label>商品等级:</label>
                    <select id="levelName" name="LevelName" style="width:150px" class="easyui-combobox" required="true">
                        <option value="">请选择</option>
                        @if (ViewData["levelNames"] != null)
                        {
                            foreach (var item in ViewData["levelNames"] as List<SelfhelpOrderMgr.Model.T_JF_GoodsLevel>)
                            {
                                <option value="@item.LevelName">@item.LevelName</option>
                            }
                        }

                    </select>
                </div>

                <div class="fitem">
                    <label>月可用积分:</label>
                    <input name="JfUseMaxPoints" class="easyui-numberbox" precision="0" required="true" />
                </div>
                <div class="fitem">
                    <label>消费月份:</label>
                    @*<input name="MonthCount" class="easyui-numberspinner" min="1" max="3" required="true" />*@
                    <input name="MonthCount" class="easyui-textbox" multiline="true" style="height:60px" required="true" />
                </div>
                <div class="fitem">
                    <label>备注:</label>
                    <input name="Remark" class="easyui-textbox" multiline="true" style="height:60px" />
                </div>

                <input type="hidden" name="Id" />
            </form>
        </div>

        <!-- 对话框按钮 -->
        <div id="dlg-buttons">
            <a href="javascript:void(0)" class="easyui-linkbutton" iconCls="icon-ok" onclick="saveItem()">保存</a>
            <a href="javascript:void(0)" class="easyui-linkbutton" iconCls="icon-cancel" onclick="javascript:$('#dlg').dialog('close')">取消</a>
        </div>

        <script>
            // 初始化数据网格
            $('#dg').datagrid({
                url: '/JfDengji/GetBaseTypeList',
                method: 'POST',
                singleSelect: true
            });

            // 格式化方法
            function formatCurrency(val) {
                return '¥' + (val ? val.toFixed(2) : '0.00');
            }

            function formatPercentage(val) {
                if (val == 0) {
                    return '';
                } else {
                    return (val || 0) + '%';
                }
                
            }

            function formatDateTime(val) {
                return val ? new Date(val).toLocaleString() : '';
            }

            // CRUD操作函数
            function newItem() {
                $('#dlg').dialog('open').dialog('setTitle', '新建');
                $('#fm').form('clear');
            }

            function editItem() {
                const row = $('#dg').datagrid('getSelected');
                if (row) {
                    $('#dlg').dialog('open').dialog('setTitle', '编辑');
                    $('#fm').form('load', row);
                }
            }

            function saveItem() {
                $('#fm').form('submit', {
                    url: '/JfDengji/BaseTypeSave',
                    onSubmit: function () {
                        $("#typeName").val($('#typeFlag').combobox('getText'));
                        //$(this).closest('form').find('input[name="TypeName"]').val('testtest');
                        return $(this).form('validate');
                    },
                    success: function (res) {
                        const result = JSON.parse(res);
                        if (result.Flag) {
                            $('#dlg').dialog('close');
                            $('#dg').datagrid('reload');
                        } else {
                            $.messager.alert('错误', result.ReMsg);
                        }
                    }
                });
            }

            function destroyItem() {
                const row = $('#dg').datagrid('getSelected');
                if (row) {
                    $.messager.confirm('确认', '确定要删除该记录吗？', function (r) {
                        if (r) {
                            $.post('/JfDengji/BaseTypeDelete', { id: row.Id }, function (res) {
                                if (res.Flag) {
                                    $('#dg').datagrid('reload');
                                } else {
                                    $.messager.alert('错误', res.ReMsg);
                                }
                            });
                        }
                    });
                }
            }


            // 购物类型式化
            function formatStatus(value) {
                const statusMap = { 0: '消费系统',1: '积分系统' };
                return statusMap[value] || '未知状态';
            }

        </script>

        <style>
            .fitem label {
                display: inline-block;
                width: 80px;
                margin: 10px 15px 10px 0;
            }
        </style>

    </div>
</body>
</html>
