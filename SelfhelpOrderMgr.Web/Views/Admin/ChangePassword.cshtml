
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>强制修改密码</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/font-awesome.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-1.11.3.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/myJs/commonJs.js"></script>
    <style>
        body { padding-top: 60px; }
        .panel-password { max-width: 480px; margin: 0 auto; }
        .alert-warning-force { text-align: center; font-weight: bold; }
        .form-control { height: 40px; font-size: 14px; }
        .form-control:focus { border-color: #428bca; box-shadow: none; }
        .btn-toggle-pwd {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #999;
            cursor: pointer;
            outline: none;
            z-index: 3;
        }
        .btn-toggle-pwd:hover { color: #428bca; }
        .input-pwd-wrap { position: relative; }
        .strength-bar {
            height: 4px;
            border-radius: 2px;
            background: #e9ecef;
            margin-top: 6px;
            overflow: hidden;
        }
        .strength-fill {
            height: 100%;
            width: 0%;
            border-radius: 2px;
            transition: width 0.3s, background 0.3s;
        }
        .strength-label {
            font-size: 12px;
            color: #999;
            margin-top: 3px;
            min-height: 16px;
        }
        .strength-label.weak   { color: #d9534f; }
        .strength-label.medium { color: #f0ad4e; }
        .strength-label.strong { color: #5cb85c; }
        .alert-area { display: none; margin-bottom: 15px; }
    </style>
    <script type="text/javascript">
        $(function () {
            //回车键触发保存
            $(document).keydown(function (e) {
                if (e.keyCode == 13) saveChangePwd();
            });

            //密码强度检测
            $('#newPassword').on('input', function () {
                checkStrength($(this).val());
            });

            //显示/隐藏密码
            $('.btn-toggle-pwd').click(function () {
                var targetId = $(this).data('target');
                var $input = $('#' + targetId);
                var $icon = $(this).find('i');
                if ($input.attr('type') === 'password') {
                    $input.attr('type', 'text');
                    $icon.removeClass('fa-eye-slash').addClass('fa-eye');
                } else {
                    $input.attr('type', 'password');
                    $icon.removeClass('fa-eye').addClass('fa-eye-slash');
                }
            });
        });

        //密码强度检测
        function checkStrength(pwd) {
            var score = 0;
            if (pwd.length >= 8) score++;
            if (pwd.length >= 12) score++;
            if (/[a-z]/.test(pwd) && /[A-Z]/.test(pwd)) score++;
            if (/\d/.test(pwd)) score++;
            if (/[^a-zA-Z0-9]/.test(pwd)) score++;

            var $bar = $('.strength-fill');
            var $label = $('.strength-label');

            if (pwd.length === 0) {
                $bar.css('width', '0%');
                $label.attr('class', 'strength-label').text('');
            } else if (score <= 2) {
                $bar.css({ 'width': '33%', 'background': '#d9534f' });
                $label.attr('class', 'strength-label weak').text('弱');
            } else if (score <= 3) {
                $bar.css({ 'width': '66%', 'background': '#f0ad4e' });
                $label.attr('class', 'strength-label medium').text('中');
            } else {
                $bar.css({ 'width': '100%', 'background': '#5cb85c' });
                $label.attr('class', 'strength-label strong').text('强');
            }
        }

        //显示提示
        function showAlert(msg, type) {
            $('.alert-area')
                .removeClass('alert-success alert-danger alert-warning')
                .addClass('alert-' + type)
                .html(msg)
                .slideDown(200);
        }

        function hideAlert() {
            $('.alert-area').slideUp(100);
        }

        function saveChangePwd() {
            var oldPlain = $('#oldPassword').val();
            var newPlain = $('#newPassword').val();
            var confirmPlain = $('#checkPassword').val();

            hideAlert();

            if (!oldPlain) {
                showAlert('<i class="fa fa-exclamation-circle"></i> 请输入旧密码', 'danger');
                $('#oldPassword').focus();
                return;
            }
            if (!newPlain) {
                showAlert('<i class="fa fa-exclamation-circle"></i> 请输入新密码', 'danger');
                $('#newPassword').focus();
                return;
            }
            if (newPlain.length < 8) {
                showAlert('<i class="fa fa-exclamation-circle"></i> 新密码长度不能少于8位', 'danger');
                $('#newPassword').focus();
                return;
            }
            if (newPlain !== confirmPlain) {
                showAlert('<i class="fa fa-exclamation-circle"></i> 两次输入的新密码不一致', 'danger');
                $('#checkPassword').focus();
                return;
            }

            //禁用按钮，防止重复提交
            var $btn = $('#btnSave');
            $btn.attr('disabled', 'disabled').text('提交中...');

            //密码两边MD5后上传后台（与登录方式一致）
            $.post('/Admin/SavePassword',
                {
                    oldPassword: md5Twice(oldPlain),
                    newPassword: md5Twice(newPlain),
                    checkPassword: md5Twice(confirmPlain)
                },
                function (data, status) {
                    $btn.removeAttr('disabled').text('确认修改');
                    if ('success' !== status) {
                        showAlert('<i class="fa fa-exclamation-triangle"></i> 请求失败，请重试', 'warning');
                        return;
                    }
                    if (data.indexOf('成功') >= 0) {
                        showAlert('<i class="fa fa-check-circle"></i> ' + data + '，请使用新密码重新登录...', 'success');
                        setTimeout(function () {
                            window.location.href = '/Admin/Index';
                        }, 1200);
                    } else {
                        showAlert('<i class="fa fa-exclamation-circle"></i> ' + data, 'danger');
                    }
                }).fail(function () {
                    $btn.removeAttr('disabled').text('确认修改');
                    showAlert('<i class="fa fa-exclamation-triangle"></i> 网络异常，请稍后重试', 'warning');
                });
        }
    </script>
</head>
<body>

    <nav class="navbar navbar-fixed-top navbar-inverse">
        <div class="container">
            <a class="navbar-brand" href="/Admin/Index">狱内消费一卡通管理系统</a>
            <ul class="nav navbar-nav">
                <li class="active"><a href="/Admin/Index">系统登录</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <div class="panel panel-danger panel-password">
            <div class="panel-heading">
                <h3 class="panel-title">密码强度不足 — 强制修改密码</h3>
            </div>
            <div class="panel-body">
                <div class="alert alert-warning alert-warning-force" role="alert">
                    您的当前密码强度不足（少于8位），为保障账户安全，请先修改密码后才能继续使用系统。
                </div>

                <div class="alert-area" role="alert"></div>

                <form id="forceChangePwdForm" onsubmit="return false;">
                    <div class="form-group">
                        <label for="oldPassword">旧密码</label>
                        <div class="input-pwd-wrap">
                            <input type="password" class="form-control" id="oldPassword" name="oldPassword"
                                   placeholder="请输入旧密码" required autofocus autocomplete="off">
                            <button type="button" class="btn-toggle-pwd" data-target="oldPassword">
                                <i class="fa fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="newPassword">新密码</label>
                        <div class="input-pwd-wrap">
                            <input type="password" class="form-control" id="newPassword" name="newPassword"
                                   placeholder="至少8位，含大小写字母、数字、特殊字符中三种" required autocomplete="off">
                            <button type="button" class="btn-toggle-pwd" data-target="newPassword">
                                <i class="fa fa-eye-slash"></i>
                            </button>
                        </div>
                        <div class="strength-bar"><div class="strength-fill"></div></div>
                        <div class="strength-label"></div>
                    </div>
                    <div class="form-group">
                        <label for="checkPassword">确认新密码</label>
                        <div class="input-pwd-wrap">
                            <input type="password" class="form-control" id="checkPassword" name="checkPassword"
                                   placeholder="请再次输入新密码" required autocomplete="off">
                            <button type="button" class="btn-toggle-pwd" data-target="checkPassword">
                                <i class="fa fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>
                    <button type="button" id="btnSave" class="btn btn-primary btn-block" onclick="saveChangePwd()">确认修改</button>
                </form>
            </div>
        </div>
    </div>

</body>
</html>
