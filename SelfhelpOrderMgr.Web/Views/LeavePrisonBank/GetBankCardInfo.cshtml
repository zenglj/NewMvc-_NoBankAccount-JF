<script src="js/bootstrap.min.js"></script>
<script src="~/Scripts/messenger.min.js"></script>
<script src="~/Scripts/myJs/minghuaICcardCommon.js"></script>
<script src="~/Scripts/myJs/commonJs.js"></script>
<script src="~/Scripts/myJs/MyNumerKeyBoard.js"></script>
<script src="~/Scripts/myJs/LeavePrisonBank.js"></script>
<script type="text/javascript">

    //根据狱政号查询用户信息
    $("#btnQuery").on("click",function () {
        var qcode = $("#queryCode").val();
        if (qcode == "" || !(qcode.length==10 || qcode.length==11)) {
            alert("Err|请输入有效的狱政编号");
            return false;
        }
        var mangCard = $("#FManagerCard").val();
        if (mangCard == "" || !(mangCard.length == 10 || mangCard.length == 11)) {
            alert("Err|请先刷管理卡登录");
            return false;
        }
        
        $.post("/LeavePrisonBank/GetManagerUserInfo", { "fcrimecode": qcode, "fmanagerCard": mangCard }, function (data, status) {
            if ("success" == status) {
                console.log(data);
                if (data.Flag == false) {
                    //清空显示信息
                    ClearDisplayInfo();
                    alert(data.ReMsg);
                } else {
                    //显示用户信息
                    SetDispUserInfo(data);
                    if (data.DataInfo.recvBankAccount != null) {
                        $("#selBankUserName").val(data.DataInfo.recvBankAccount.BankUserName);
                        $("#selOutBankRemark").val(data.DataInfo.recvBankAccount.OutBankRemark);
                        $("#selOpeningBank").val(data.DataInfo.recvBankAccount.BankCNAPS);
                        $("#selOutBankCard").val(data.DataInfo.recvBankAccount.OutBankCard);
                        if (data.DataInfo.recvBankAccount.CheckFlag == 1) {
                            $("#btnNext").attr('disabled', 'disabled');
                            alert("用户已经确认不能再修改");
                            return false;
                        }
                        else {
                            $("#btnNext").removeAttr('disabled');
                        }
                    } else {
                        ClearAccountEditArea();
                    }
                }

            }
        });
    });

    //下一步
    function btnNext() {
        if ($("#selOpeningBank").val() == "") {
            alert("请选择一个银行");
            return false;
        }
        var bankcard = $("#selOutBankCard").val()
        if (bankcard == "" || !(bankcard.length == 16 || bankcard.length == 17 || bankcard.length == 19)) {
            alert("请选择一个收款账号");
            return false;
        }


        $("#tdDisBankUserName").html($("#selBankUserName").val());
        $("#tdDisOutBankRemark").html($("#selOutBankRemark").val());
        $("#tdDisOpeningBank").html($("#selOpeningBank").find("option:selected").text());
        $("#tdDisBankCNAPS").html($("#selOpeningBank").val());
        $("#tdDisOutBankCard").html($("#selOutBankCard").val());

        $("#divPayDisplayInfo").show();
        $("#divPaySelArea").hide();
    }

    //上一步
    function btnBack() {
        $("#divPayDisplayInfo").hide();
        $("#divPaySelArea").show();
    }


    //根据狱政号查询用户信息
    $("#btnSubmit").on("click", function () {
        var bankcard = $("#tdDisOutBankCard").html();
        if (bankcard == "" || !(bankcard.length == 16 || bankcard.length == 17 || bankcard.length == 19)) {
            alert("Err|请输入有效的银行卡号");
            return false;
        }
        var bankAccount = {
            FCrimeCode: $("#tdFCrimeCode").html()
            , OutBankCard: bankcard
            , OpeningBank: $("#tdDisOpeningBank").html()
            , BankCNAPS: $("#tdDisBankCNAPS").html()
            , BankUserName: $("#tdDisBankUserName").html()
            , OutBankRemark: $("#tdDisOutBankRemark").html(
            )
        };
        $.post("/LeavePrisonBank/SetBankInfo", bankAccount, function (data, status) {
            if ("success" == status) {
                console.log(data);
                if (data.Flag == true) {
                    ClearDisplayInfo();
                    $("#divPayDisplayInfo").hide();
                    $("#divPaySelArea").show();
                }
                alert(data.ReMsg);
            }
        });
    });



</script>

