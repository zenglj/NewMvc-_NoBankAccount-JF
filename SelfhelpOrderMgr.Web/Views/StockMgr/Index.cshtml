                        type: 'POST',
                        // 1. 必须设置 Content-Type 为 application/json
                        contentType: 'application/json; charset=utf-8',
                        // 2. 必须使用 JSON.stringify 将对象转为字符串
                        data: JSON.stringify(dto),
                        dataType: 'json',
