            overflow-y: auto;
            padding: 20px;
        }

        .footer {
            height: 100px;
            background-color: #333;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-item {
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid #eee;
        }

            .product-item:last-child {
                border-bottom: none;
            }

        .face-pay-icon {
            font-size: 60px;
            margin-bottom: 15px;
        }

        .bg_topDiv {
            background-image: url(/Content/images/SelfOrderManager1.jpg);
            padding: 0;
            margin-bottom: 0;
            height: 70px;
