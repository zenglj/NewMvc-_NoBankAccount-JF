    <script>
        // 更新当前时间
        function updateTime() {
            const now = new Date();
            const timeStr = now.toLocaleString('zh-CN', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: false
            }).replace(/\//g, '-');
            document.getElementById('current-time').textContent = timeStr;
        }

        // 每秒更新时间
        setInterval(updateTime, 1000);
        updateTime(); // 初始化时立即更新
    </script>
