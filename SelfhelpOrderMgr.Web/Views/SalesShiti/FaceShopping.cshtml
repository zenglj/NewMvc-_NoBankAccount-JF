@{ Layout = null;}

<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- 上述3个meta标签*必须*放在最前面，任何其他内容都*必须*跟随其后！ -->
    <title>处遇兑现购物系统</title>

    <!-- Bootstrap -->
    @*<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" integrity="sha384-HSMxcRTRxnN+Bdg0JdbxYKrThecOKuH5zCYotlSAcp1+c8xmyTe9GYg1l9a69psu" crossorigin="anonymous">*@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />


    <style>
        body {
            background-color: #f5f5f5;
            font-family: 'Microsoft YaHei', sans-serif;
        }

        .containerBox {
            width: 900px;
            height: 100px;
            margin: 0 auto;
            padding: 0;
            background-color: white;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .header {
            height: 150px;
            background-color: #1261AE;
            color: white;
            padding: 10px;
        }

        .barcode-section {
            padding: 15px;
            background-color: #e7e7e7;
        }

        .product-list {
            height: 800px;
            overflow-y: auto;
            padding: 20px;
        }

        .footer {
            height: 70px;
            background-color: #333;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-item {
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid #eee;
        }

            .product-item:last-child {
                border-bottom: none;
            }

        .face-pay-icon {
            font-size: 60px;
            margin-bottom: 15px;
        }

        .bg_topDiv {
            background-image: url(/Content/images/SelfOrderManager1.jpg);
            padding: 0;
            margin-bottom: 0;
            height: 70px;
        }

        /* =============== 核心修改区域 =============== */
        /* 移除了单独的 .product-td 定义，改为统一表格样式 */

        /* 1. 强制表格所有单元格垂直居中 */
        .table tbody td,
        .table thead th {
            vertical-align: middle !important;
            text-align: center; /* 保持水平居中 */
            font-size: large; /* 将原有的 large 字体大小移到这里，应用给所有单元格 */
        }

        /* 2. 专门优化图片样式，防止图片导致垂直居中失效 */
        .table td img {
            max-height: 60px;
            width: auto;
            display: block;
            margin: 0 auto; /* 图片在单元格内水平居中 */
        }
        /* =============== 核心修改区域 =============== */
    </style>
</head>
<body>    <div class="containerBox">        <div class="bg_topDiv">            <div class="row">                <div class="col-sm-10"></div>                <div class="col-sm-2">                    <a href="@ViewData["loginUrl"]" class="btn btn-info" role="button">返回识别界面</a>                    <input type="hidden" id="loginUrl" value="@ViewData["loginUrl"]" />                </div>            </div>        </div>        <!-- 顶部人员信息区域 -->        <div class="header">            <div class="row">                <div class="col-xs-4 col-sm-4">                    <div class="text-center">                        <span class="glyphicon glyphicon-user face-pay-icon"></span>                        <h3>人脸支付结算</h3>                    </div>                </div>                <div class="col-xs-4 col-sm-4">                    @if (ViewData["Model"] != null)                    {                        var rs = ViewData["Model"] as SelfhelpOrderMgr.Model.ResultInfo;                        var mod = rs.DataInfo as SelfhelpOrderMgr.Web.rtnStatus;        <div class="user-info">            <input type="hidden" id="orderId" value="@mod.orderId" />            <p><strong>姓名：</strong>@mod.FName</p>            <p><strong>狱号：</strong><span id="fcrimecode">@mod.FCrimeCode</span></p>            <p><strong>处遇：</strong>@mod.cyName</p>            <p><strong>当前时间：</strong><span id="current-time">2023-05-15 14:30:25</span></p>        </div>}                </div>                <div class="col-xs-4 col-sm-4">                    @if (ViewData["Model"] != null)                    {                        var rs = ViewData["Model"] as SelfhelpOrderMgr.Model.ResultInfo;                        var mod = rs.DataInfo as SelfhelpOrderMgr.Web.rtnStatus;        <div class="user-info">            <p><strong>消费订单编号：</strong>@mod.orderId</p>            <p><strong>本月消费限额：</strong><span class="label label-danger">@mod.NoXiaofeimoney</span></p>            <p><strong>账户可用余额：</strong>@mod.OkUseAllMoney</p>            <p><strong>本月已经消费：</strong>@mod.Xiaofeimoney</p>        </div>}                </div>            </div>        </div>        <!-- 商品列表区域 -->        <div class="product-list">            <h3>已选商品</h3>            <table class="table table-condensed">                <thead class=" text-center">                    <tr>                        <th>图片</th>                        <th>名称</th>                        <th>单价</th>                        <th>数量</th>                        <th>小计</th>                        <th>操作</th>                    </tr>                </thead>                <tbody id="productList">                    @if (ViewData["Model"] != null)                    {                        var rs = ViewData["Model"] as SelfhelpOrderMgr.Model.ResultInfo;                        var mod = rs.DataInfo as SelfhelpOrderMgr.Web.rtnStatus;                        if (mod.lists != null)                        {                            foreach (var good in mod.lists)                            {        <tr>            <td>                <img src="@good.src" alt="@good.GName" class="img-responsive" style="height:60px">            </td>            <td class="product-td">@good.GName</td>            <td class="product-td">¥@good.GPrice</td>            <td class="product-td">@good.GCount</td>            <td class="product-td">¥@good.GAmount</td>            <td class="product-td"><button type="button" class="btn btn-danger" onclick="btnDel(@good.ID)"><span class="glyphicon glyphicon-trash"></span></button></td>        </tr>}}}                </tbody>            </table>        </div>    </div>    <!-- 底部结算区域 -->    <nav class="navbar navbar-default navbar-fixed-bottom navbar-inverse">        <!-- 条码输入区域 -->        <div class="barcode-section">            <div class="row">                <div class="col-xs-3">                </div>                <div class="col-xs-3">                    <div class="form-group ">                        <div class="input-group">                            <span class="input-group-btn">                                <label class="btn"><strong>数量：</strong></label>                            </span>                            <input type="text" class="form-control" id="gcount-input" placeholder="数量" value="1">                        </div>                    </div>                </div>                <div class="col-xs-6">                    <div class="form-group " style="width: 90%;">                        <div class="input-group">                            <span class="input-group-btn">                                <label class="btn"><strong>扫描商品条码：</strong></label>                            </span>                            <input type="text" class="form-control" id="barcode-input" placeholder="请扫描或输入商品条码">                            <span class="input-group-btn">                                <button class="btn btn-primary" type="button" onclick="btnAdd()">扫描</button>                            </span>                        </div>                    </div>                </div>            </div>        </div>        <div class="footer">            @if (ViewData["Model"] != null)            {                var rs = ViewData["Model"] as SelfhelpOrderMgr.Model.ResultInfo;                var mod = rs.DataInfo as SelfhelpOrderMgr.Web.rtnStatus;<button type="button" class="btn btn-success btn-lg btn-block" style="width: 90%;" id="btnSubmit" onclick="SubmitOrder()">确认结算 (¥@mod.orderMoney)</button> }else{<button type="button" class="btn btn-success btn-lg btn-block" style="width: 90%;" id="btnSubmit" onclick="SubmitOrder()">确认结算 (¥0)</button>}        </div>    </nav>    @*小票模板*@    @{Html.RenderPartial("~/Views/Shared/_PartialXiaopiaoTemplateBody.cshtml");}    <!-- jQuery (Bootstrap 的所有 JavaScript 插件都依赖 jQuery，所以必须放在前边) -->    <!--<script src="https://cdn.jsdelivr.net/npm/jquery@1.12.4/dist/jquery.min.js" integrity="sha384-nvAa0+6Qg9clwYCGGPpDQLVpLNn0fRaROjHqs13t4Ggj3Ez50XnGQqc/r8MhnRDZ" crossorigin="anonymous"></script>-->    <!-- 加载 Bootstrap 的所有 JavaScript 插件。你也可以根据需要只加载单个插件。 -->    <!--<script src="https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js" integrity="sha384-aJ21OjlMXNL5UyIl/XNwTMqvzeRMZH2w8c5cRVpzpU8Y5bApTppSuUkhZXN0VxHd" crossorigin="anonymous"></script>-->    <script src="~/Scripts/jquery-1.11.3.min.js"></script>    <script src="~/Scripts/bootstrap.min.js"></script>    <script src="~/Scripts/myJs/commonJs.js"></script>    <script src="~/Scripts/myJs/LodopFuncs.js"></script>    <script src="~/Scripts/myJs/opertorXiaopiaoFunc.js"></script>    <script src="~/Scripts/jsCustom/my-alert.js"></script>    <script>        //<td>        //    <img src="~/Content/GoodsImages/chart.js.png" alt="商品1" class="img-responsive" style="height:60px">        //                </td>        //    <td class="product-td">康师傅红烧牛肉面 105g</td>        //    <td class="product-td">¥4.50</td>        //    <td class="product-td">2</td>        //    <td class="product-td">¥9.00</td>        //var dataList = [        //    { Id: 1, src: "/Content/GoodsImages/chart.js.png", GName: "康师傅红烧牛肉面 105g", GPrice: 4.50, GCount: 2, GAmount: 9.00, Remark: "" }        //    , { Id: 2, src: "/Content/GoodsImages/gruntjs.png", GName: "乐事薯片 原味 104g", GPrice: 7.80, GCount: 1, GAmount: 7.80, Remark: "" }        //    , { Id: 3, src: "/Content/GoodsImages/chart.js.png", GName: "可口可乐 330ml", GPrice: 3.50, GCount: 1, GAmount: 3.50, Remark: "" }];        var dataList = [];        $(document).ready(function () {            $('input').keydown(function (event) {                if (event.which === 13) { // 检测是否按下了回车键                    // 回车键被按下时执行的代码                    btnAdd();                    // 例如，阻止表单的默认提交行为                    event.preventDefault();                }            });        });        function btnAdd() {            let gtxm = $("#barcode-input").val();            if (gtxm == '') {                //showMyAlert('danger', '商品条码不能为空', 5000); // 2秒后自动关闭                showMyAlert('danger', '商品条码不能为空！', 2000, 'center');                return false;            }            $.post("/SalesShiti/AddDetaiGood", {                "orderId": $("#orderId").val(),                "gtxm": gtxm,                "gcount": $("#gcount-input").val(),                "goodRemark": ""            }, function (data, status) {                if ("success" == status) {                    if (data.Flag) {                        //dataList.push(data.DataInfo);                        dataList = data.DataInfo;                        loadData();                        showMyAlert('success', data.ReMsg, 1000, 'center');                    } else {                        //alert(data.ReMsg);                        //showMyAlert('danger', data.ReMsg, 5000); // 2秒后自动关闭                        showMyAlert('danger', data.ReMsg, 3000, 'center');                    }                }            });            $("#gcount-input").val('1');            $("#barcode-input").val('');            $("#barcode-input").focus();        }        function btnDel(rowId) {            //dataList.splice(rowId, 1);            //loadData();            $.post("/SalesShiti/DelDetaiGood", {                "orderId": $("#orderId").val(),                "id": rowId            }, function (data, status) {                if ("success" == status) {                    if (data.Flag) {                        //dataList.push(data.DataInfo);                        dataList = data.DataInfo;                        loadData();                        showMyAlert('success', data.ReMsg, 1000, 'center');                    } else {                        //alert(data.ReMsg);                        //showMyAlert('danger', data.ReMsg, 5000); // 2秒后自动关闭                        showMyAlert('danger', data.ReMsg, 3000, 'center');                    }                }            });        }        function loadData() {            $("#productList").empty();            /*dataList.push(data.DataInfo);*/            var _html = "";            let _sumMoney = 0;            for (var i = 0; i < dataList.length; i++) {                var row = dataList[i];                var _html = _html + "<tr><td>"                    + "<img src='" + row.src + "' alt='" + row.GName + "' class='img-responsive' style='height:60px'>"                    + "</td>"                    + "<td class='product-td'>" + row.GName + "</td>"                    + "<td class='product-td'>¥" + row.GPrice + "</td>"                    + "<td class='product-td'>" + row.GCount + "</td>"                    + "<td class='product-td'>¥" + row.GAmount + "</td>"                    + "<td><button type='button' class='btn btn-danger' onclick='btnDel(" + row.ID + ")'><span class='glyphicon glyphicon-trash'></span></button></td>"                    + "</tr>";                _sumMoney = _sumMoney + row.GAmount;            }            $("#productList").html(_html);            $("#btnSubmit").html("确认结算 (¥" + toDecimal2(_sumMoney) + ")");        }        function SubmitOrder() {            //$.post("/SalesShiti/SubmitOrder", {            //    "orderId": $("#orderId").val(),            //    "fcrimecode": $("#fcrimecode").html()            //}, function (data, status) {            //    if ("success" == status) {            //        if (data.Flag) {            //            //dataList.push(data.DataInfo);            //            dataList = data.DataInfo;            //            loadData();            //            showMyAlert('success', data.ReMsg, 1000, 'center');            //        } else {            //            //alert(data.ReMsg);            //            //showMyAlert('danger', data.ReMsg, 5000); // 2秒后自动关闭            //            showMyAlert('danger', data.ReMsg, 3000, 'center');            //        }            //    }            //});            $.post("/SalesShiti/SubmitOrder", {                "orderId": $("#orderId").val(),                "fcrimecode": $("#fcrimecode").html()            }, function (data, status) {                if ("success" != status) {                    return false;                } else {                    //var words = data.split("|");                    if (data.Flag == true) {                        var inv = data.DataInfo;                        SetPrintPayXiaopiao(inv);                        //myTestHtml("#template");                        var PrintXPItemS = $("#PrintXPItemS").val();                        var pItems = PrintXPItemS.split("|");                        for (var i = 0; i < pItems.length; i++) {                            var item = pItems[i];                            //开始打印小票                            //myTestHtml("#" + item, $("#xiaoPiaoPageWidth").val());                            printXiaoPiaoXinxi("#" + item, $("#xiaoPiaoPageWidth").val());                            $.post("/Home/UpdatePrintCount", { "Invoices": inv.invoice.InvoiceNo }, function (data, status) {                                if ("success" == data) {                                    //alert(data);                                    //$.messager.alert("提示", data);                                }                            });                        }                        setTimeout(function () {                            //do thing                            //window.open("/SalesShiti/Index");                            window.open($("#loginUrl").val());                                                    }, 3000);                        //if ($("#loginModeFlag").val() == "2") {                        //    setTimeout(function () {                        //        //do thing                        //        window.open("/SalesShiti/Index");                        //    }, 3000);                        //}                        //else {                        //    goSaleHead();                        //}                    }                    else {                        showMyAlert('danger', data.ReMsg, 6000, 'center');                    }                }            });        }        //设定填写结算小票的内容        function SetPrintPayXiaopiao(invData) {            var inv = invData;            $("#template").empty();//清空            $("#PrintXPItemS").val('');            var PrintXPItemS = "";            var k = 0;            //如果长度大于22行            if (inv.details.length > 20) {                //前22行=====================                if (PrintXPItemS == "") {                    PrintXPItemS = "temp" + k;                } else {                    PrintXPItemS = PrintXPItemS + "|temp" + k;                }                var xiaopiao = "<div id='temp" + k + "'><div> <div style='text-align:left;font-size:" + (parseInt($("#xiaoPiaoFontSize").val()) + 3) + "px;'>消费一卡通系统</div>"                    + "<table style='font-size:" + $("#xiaoPiaoFontSize").val() + "px; width:200px;'>"                    + "<tbody>"                    + "<tr><td>单号：" + inv.invoice.InvoiceNo + "</td></tr>"                    + "<tr><td>日期：" + getLongTime(inv.invoice.OrderDate) + "</td></tr>"                    + "<tr><td>编号：" + inv.invoice.FCrimeCode + "</td></tr>"                    + "<tr><td>姓名：" + inv.invoice.FCriminal + "</td></tr>"                    + "<tr><td colspan='2'>队别：" + inv.invoice.FAreaName + "（房号:" + inv.invoice.RoomNo + "）</td></tr>"                    + "<tr><td>消费时首次打印</td></tr>"                    + "</tbody>"                    + "</table>"                    + "<hr />"                    + "<table style='font-size:" + $("#xiaoPiaoFontSize").val() + "px;'>"                    + "<thead>"                    + "<tr><th>品名</th><th style='width:30px;'>单价</th><th style='width:30px;'>数量</th><th style='width:30px;'>金额</th></tr>"                    + "</thead>"                    + "<tbody>";                for (var j = 0; j < 20; j++) {                    var remark = "";                    if (inv.details[j].Remark != "") {                        remark = "【" + inv.details[j].Remark + "】";                    }                    xiaopiao = xiaopiao + "<tr><td>" + inv.details[j].GTXM + "</td><td align='center'>" + inv.details[j].GDJ + "</td><td align='center'>" + inv.details[j].QTY + "</td><td align='right'>" + inv.details[j].AMOUNT + "</td></tr>"                        + "<tr><td colspan='4' style=' border-bottom:dashed;border-bottom-width:1px;'>" + inv.details[j].GNAME + remark + "</td></tr>"                }                xiaopiao = xiaopiao + "</tbody>"                    + "</table>"                    + "<div>（这里第1页），下面还有内容</div>"                    + "</div><br/></div>";                $("#template").append(xiaopiao);                k++;                //后20行=====================                if (PrintXPItemS == "") {                    PrintXPItemS = "temp" + k;                } else {                    PrintXPItemS = PrintXPItemS + "|temp" + k;                }                var xiaopiao = "<div id='temp" + k + "'><div> <div style='text-align:center'>" + inv.invoice.InvoiceNo + " (第2页)</div>"                    + "<table style='font-size:" + $("#xiaoPiaoFontSize").val() + "px;'>"                    + "<thead>"                    + "<tr><th>品名</th><th style='width:30px;'>单价</th><th style='width:30px;'>数量</th><th style='width:40px;'>金额</th></tr>"                    + "</thead>"                    + "<tbody>";                for (var j = 20; j < inv.details.length; j++) {                    var remark = "";                    if (inv.details[j].Remark != "") {                        remark = "【" + inv.details[j].Remark + "】";                    }                    xiaopiao = xiaopiao + "<tr><td>" + inv.details[j].GTXM + "</td><td align='center'>" + inv.details[j].GDJ + "</td><td align='center'>" + inv.details[j].QTY + "</td><td align='right'>" + inv.details[j].AMOUNT + "</td></tr>"                        + "<tr><td colspan='4' style=' border-bottom:dashed;border-bottom-width:1px;'>" + inv.details[j].GNAME + remark + "</td></tr>"                }                xiaopiao = xiaopiao + "</tbody>"                    + "</table>"                    + "<hr />"                    + "<span>消费合计：" + inv.invoice.Amount + "元</span><hr/>"                    + "<div style='font-size:" + (parseInt($("#xiaoPiaoFontSize").val()) + 1) + "px;'>存款账户余额:" + inv.criminal.AmountA + "元</div>"                    + "<div style='font-size:" + (parseInt($("#xiaoPiaoFontSize").val()) + 1) + "px;'>报酬账户余额:" + inv.criminal.AmountB + "元</div>"                    + "<div style='font-size:" + (parseInt($("#xiaoPiaoFontSize").val()) + 1) + "px;'>留存账户余额:" + inv.criminal.AmountC + "元</div>"                    + "<div style='font-size:" + (parseInt($("#xiaoPiaoFontSize").val()) + 1) + "px;'>蓝风铃余额:" + inv.criminal.AmountD + "元</div>"                    + "<div style='font-size:" + (parseInt($("#xiaoPiaoFontSize").val()) + 1) + "px;'>账户总余额:" + toDecimal2(inv.criminal.AmountA + inv.criminal.AmountB + inv.criminal.AmountC + inv.criminal.AmountD) + "元</div>"                    + "</div><br/></div>";                $("#template").append(xiaopiao);                k++;                //======结束========================            } else {                if (PrintXPItemS == "") {                    PrintXPItemS = "temp" + k;                } else {                    PrintXPItemS = PrintXPItemS + "|temp" + k;                }                var xiaopiao = "<div id='temp" + k + "'><div> <div style='text-align:left;font-size:" + (parseInt($("#xiaoPiaoFontSize").val()) + 3) + "px;'>监狱一卡通系统</div>"                    + "<table style='font-size:" + $("#xiaoPiaoFontSize").val() + "px; width:200px;'>"                    + "<tbody>"                    + "<tr><td>单号：" + inv.invoice.InvoiceNo + "</td></tr>"                    + "<tr><td>日期：" + getLongTime(inv.invoice.OrderDate) + "</td></tr>"                    + "<tr><td>编号：" + inv.invoice.FCrimeCode + "</td></tr>"                    + "<tr><td>姓名：" + inv.invoice.FCriminal + "</td></tr>"                    + "<tr><td colspan='2'>队别：" + inv.invoice.FAreaName + "（房号:" + inv.invoice.RoomNo + "）</td></tr>"                    + "<tr><td>消费时首次打印</td></tr>"                    + "</tbody>"                    + "</table>"                    + "<hr />"                    + "<table style='font-size:" + $("#xiaoPiaoFontSize").val() + "px;'>"                    + "<thead>"                    + "<tr><th>品名</th><th style='width:30px;'>单价</th><th style='width:30px;'>数量</th><th style='width:40px;'>金额</th></tr>"                    + "</thead>"                    + "<tbody>";                for (var j = 0; j < inv.details.length; j++) {                    var remark = "";                    if (inv.details[j].Remark != "") {                        remark = "【" + inv.details[j].Remark + "】";                    }                    xiaopiao = xiaopiao + "<tr><td>" + inv.details[j].GTXM + "</td><td align='center' style='width:30px;'>" + inv.details[j].GDJ + "</td><td align='center' style='width:30px;'>" + inv.details[j].QTY + "</td><td align='right' style='width:30px;'>" + inv.details[j].AMOUNT + "</td></tr>"                        + "<tr><td colspan='4' style=' border-bottom:dashed;border-bottom-width:1px;'>" + inv.details[j].GNAME + remark + "</td></tr>"                }                xiaopiao = xiaopiao + "</tbody>"                    + "</table>"                    + "<hr />"                    + "<span>消费合计：" + inv.invoice.Amount + "元</span><hr/>"                    + "<div style='font-size:" + (parseInt($("#xiaoPiaoFontSize").val()) + 1) + "px;'>存款账户余额:" + inv.criminal.AmountA + "元</div>"                    + "<div style='font-size:" + (parseInt($("#xiaoPiaoFontSize").val()) + 1) + "px;'>报酬账户余额:" + inv.criminal.AmountB + "元</div>"                    + "<div style='font-size:" + (parseInt($("#xiaoPiaoFontSize").val()) + 1) + "px;'>留存账户余额:" + inv.criminal.AmountC + "元</div>"                    + "<div style='font-size:" + (parseInt($("#xiaoPiaoFontSize").val()) + 1) + "px;'>蓝风铃余额:" + inv.criminal.AmountD + "元</div>"                    + "<div style='font-size:" + (parseInt($("#xiaoPiaoFontSize").val()) + 1) + "px;'>账户总余额:" + toDecimal2(inv.criminal.AmountA + inv.criminal.AmountB + inv.criminal.AmountC + inv.criminal.AmountD) + "元</div>"                    + "</div><br/></div>";                $("#template").append(xiaopiao);                k++;            }            $("#PrintXPItemS").val(PrintXPItemS);        }    </script></body>
</html>