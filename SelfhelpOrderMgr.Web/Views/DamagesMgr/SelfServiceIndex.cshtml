
@{
    ViewBag.Title = "自助扣款";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{Html.RenderPartial("~/Views/Shared/_PartialXiaopiaoControl.cshtml");}
<link href="~/Content/font-awesome.min.css" rel="stylesheet" />
<link href="~/Content/docs.min.css" rel="stylesheet" />
<link href="~/Scripts/simple-calendar/tcal.css" rel="stylesheet" />
<link href="~/Scripts/jsCustom/bootstrap-messager.css" rel="stylesheet" />
<div class="page-header text-center">
    <h2><small>欢迎进入</small> 赔偿金申请计划 <small>这里您自助办理</small></h2>
    <input type="hidden" id="UserName" name="UserName" value="@ViewData["UserName"]" />
    <input type="hidden" id="FManagerCard" name="FManagerCard" value="@ViewData["FManagerCard"]" />
    <input type="hidden" id="FCrimeCode" name="FCrimeCode" value="@ViewData["fcrimecode"]" />
    <input type="hidden" id="FIcCardCode" name="FIcCardCode" />
</div>

<div class="container">
    <object id=MWRFATL style="WIDTH: 0px; HEIGHT: 0px"
            codebase=eyeFZ.cab#version =1,0,0,1
            classid=CLSID:CD851DCA-5D3C-4DA9-A0F7-DE018FDC0A7F></object>@*加载数明华读卡器控件*@


            <div class="row">
                <div class="col-sm-6">
                    <h3 id="userNameInfo">你好, 某某某<span class="label label-primary">普管(500)</span>,您的账户信息如下：</h3>

                </div>
                <div class="col-sm-6">
                    <div style=" text-align:right;">
                        <input type="hidden" id="orderFcrimeCode" />
                        <input type="hidden" id="orderFcrimeName" />
                        <input type="hidden" id="orderCyName" />
                        <input type="hidden" id="orderFareaName" />
                        @if (ViewData["LoginMode"].ToString() == "2")
                        {
                            <a class="btn btn-large btn-primary btn-lg" href="/Home/WebCamTest3?callback=/SelfPayment/Index?managerCardNo=@ViewData["FManagerCard"]" role="button">人脸识别</a>

                        }
                        else if (ViewData["LoginMode"].ToString() == "1")
                        {
                            <div class="form-inline">
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-addon">用户号</div>
                                        <input class="form-control" type="number" id="userCode" name="userCode" placeholder="用户号" onkeydown="if(event.keyCode==13) $('#UserPwd').focus();" style="width:150px;">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-addon">密码</div>
                                        <input class="form-control" type="password" id="UserPwd" name="UserPwd" placeholder="密码" onkeydown="if (event.keyCode == 13) $('#btnSearch').focus();" style="width:150px;">
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary" id="btnSearch" onclick="UserLoginCheck()">查询</button>

                            </div>


                        }
                        else
                        {
                            <a class="btn btn-large btn-primary btn-lg" href="#" role="button" onclick="btnQueryUserInfo('3504013494')">请先刷IC卡查询</a>

                        }
                    </div>
                </div>

            </div>
            <div class="alert alert-danger" role="alert" id="lblInfo">银行账号：</div>
            <div class="row">
                <div class="col-md-3">
                    <table class="table">
                        <thead>
                            <tr><th>名称</th><th>金额</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>存款余额</td><td id="amountA">0.00</td></tr>
                            <tr><td>报酬金额</td><td id="amountB">0.00</td></tr>
                            <tr><td>留存金额(不可用)</td><td id="amountC">0.00</td></tr>
                            <tr><td>本月已经消费</td><td><span class="label label-danger" id="curMonthXFE">0.00</span></td></tr>
                            <tr><td>本月消费限额</td><td><span class="label label-warning" id="xiaofeiYuE">0.00</span></td></tr>
                            <tr class="danger"><td>账户可用总余额</td><td id="okUseAllMoney">0.00</td></tr>
                        </tbody>
                    </table>

                </div>
                <div class="col-md-9">
                    <div id="topTitleDiv">
                        <h4>
                            请选择申请条件 ：
                        </h4>
                    </div>
                    
                    <div>
                        <form id="fm" action="/DamagesMgr/RequestRecSave" method="post">
                            <input type="hidden" name="FCrimeCode" />
                            <input type="hidden" name="FCrimeName" />
                            <input type="hidden" name="FAreaCode" />

                            <div class="form-group form-inline">
                                <div class="input-group">
                                    <div class="input-group-addon">申请类型：</div>
                                    <select class="form-control input-lg" id="editTypeId" name="TypeId">
                                        <option value="" selected="selected">请选择</option>
                                        @if (ViewData["baseTypes"] != null)
                                        {
                                            foreach (SelfhelpOrderMgr.Model.T_AREA savetype in ViewData["baseTypes"] as List<SelfhelpOrderMgr.Model.T_AREA>)
                                            {
                                                <option value="@savetype.FCode">@savetype.FName</option>
                                            }
                                        }

                                    </select>
                                </div>

                            </div>

                            <div class="form-group form-inline">
                                <div class="input-group form-inline">
                                    <div class="input-group-addon">申请时长：</div>
                                    <select class="form-control input-lg" id="editUseMonths" name="UseMonths" onchange="changeUseMonths()">
                                        <option value="" selected="selected">请选择</option>
                                        <option value="6">半年</option>
                                        <option value="12">1年</option>
                                        <option value="24">2年</option>
                                        <option value="36">3年</option>
                                    </select>
                                </div>

                            </div>

                            <div class="form-group form-inline">
                                <div class="input-group">
                                    <div class="input-group-addon">到期时间：</div>
                                    <input type="date" class="form-control input-lg" id="editEndTime" name="EndTime" onkeydown="if (event.keyCode == 13) $('#btnSubmitKK').focus();" placeholder="截止日期">

                                </div>

                            </div>



                            <div class="row">
                                <div class="col-sm-10">
                                    <button type="submit" id="btnSubmitKK" class="btn btn-danger btn-lg">提交申请</button>
                                </div>
                                <div class="col-sm-2">
                                    <a href="/Home/Index" class="btn btn-warning" role="button">退回首页</a>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>

        <script src="~/Scripts/jquery-1.11.3.min.js"></script>
        <script src="~/Scripts/bootstrap.min.js"></script>
        <script src="~/Scripts/jsCustom/bootstrap-messager.js"></script>
        <script src="~/Scripts/myJs/minghuaICcardCommon.js"></script>
        <script src="~/Scripts/myJs/commonJs.js"></script>
        <script src="~/Scripts/myJs/myNewCommonJs.js"></script>

        <script type="text/javascript">
            $(document).ready(function () {
                // 此处填写页面加载完成后要执行的操作
                if ($("#FManagerCard").val() != undefined && $("#FManagerCard").val() != "" && $("#FCrimeCode").val() != undefined && $("#FCrimeCode").val() != "") {
                    $.post("/SelfPayment/QueryUserInfo", { "fcrimecode": $("#FCrimeCode").val(), "checkFlag": "1", "FManagerCard": $("#FManagerCard").val(), "UserName": $("#UserName").val() }, function (data, status) {
                        if ("success" != status) {
                            return false;
                        } else {
                            var words = data.split("|")
                            if (words[0] == "Error") {
                                $("#lblInfo").html(data);
                                $("#userNameInfo").html("对不起，没有查到您的账户信息，请与管教联系！");
                                ClearUserDisplayInfo();
                            } else if (words[0] == "There") {
                                SetAndDisplayUserInfo(words[1]);
                            }
                            else {
                                //SetAndDisplayCriminalInfo(words[1], saleSort);//显示抬头栏的账户余额信息
                            }
                        }
                    });
                }

            });

            

            function changeUseMonths() {
                if ($("#editUseMonths").find("option:selected").val() == "") {
                    //Messager.alert({
                    //    title: '警告',
                    //    content: '请先选择时长！',
                    //    timeout: 0  // 不自动关闭
                    //});
                    alert('请先选择时长！');
                    return false;
                }

                var usemonth = $("#editUseMonths").find("option:selected").val();
                var today = new Date();
                today.setMonth(today.getMonth() + parseInt(usemonth));
                var dd = String('0'+today.getDate()).slice(-2);
                var mm = String('0' + (today.getMonth() + 1)).slice(-2); //January is 0!
                var yyyy = today.getFullYear();
                today = yyyy + '-' + mm + '-' + dd;
                $("#editEndTime").val(today);
                $('#btnSubmitKK').removeAttr("disabled");
            }


            //读取IC卡号
            function readCardNo() {
                //$("#lblInfo").html("0000000");
                var cardNo = "";
                Connect();//连接读卡器
                //$("#lblInfo").html("连接成功");
                var xunka = Scard();//寻卡
                if (xunka != "") {
                    //$("#lblInfo").html(xunka);
                    var rlk = ReaderLoadKey();//装载密码
                    if (rlk == "1") {
                        //$("#lblInfo").html("装载密码成功");
                        var athk = authenticationKey();//验证密码
                        if (athk == "1") {
                            // $("#lblInfo").html("验证密码成功");
                            cardNo = readDataHex();//以16进制的方式读卡
                            if (cardNo != "") {
                                //$("#lblInfo").html("读卡完成");
                            }
                        }
                    }
                }
                //$("#lblInfo").html(xunka);
                //alert(cardNo);
                exit();//断开读卡器连接
                return cardNo;
            }
            //读卡查询用户信息
            function btnQueryUserInfo(e, saleSort) {
                var cardNo = readCardNo();
                //alert(cardNo);
                //alert("e3232");
                QueryUserInfo(cardNo);
            }
            //查询用户信息
            function QueryUserInfo(cardNo) {
                $("#lblInfo").html(cardNo);
                $.post("/UserQuery/QueryUserInfo", { "FCardCode": cardNo, "checkFlag": "1", "startDate": $("#startDate").val(), "endDate": $("#endDate").val() }, function (data, status) {
                    if ("success" != status) {
                        return false;
                    } else {
                        var words = data.split("|")
                        if (words[0] == "Error") {
                            $("#lblInfo").html(data);
                            $("#userNameInfo").html("对不起，您所持的不是有效的IC消费卡，请与管教联系！");
                            ClearUserDisplayInfo();
                        } else if (words[0] == "There") {
                            SetAndDisplayUserInfo(words[1]);
                        }
                        else {
                            //SetAndDisplayCriminalInfo(words[1], saleSort);//显示抬头栏的账户余额信息
                        }
                    }
                });

            }


            //用户登录查询
            function UserLoginCheck() {
                //var cardNo = readCardNo();
                var userCode = $("#userCode").val();
                var userPwd = $("#UserPwd").val();
                //$("#managerCard").html("管理卡号：" + userName);
                if (userCode != "") {
                    $.post('/UserQuery/GetCardInfo', { "userCode": userCode, "userPwd": userPwd },
                        function (data, status) {
                            if ('success' != status) {
                                return false;
                            } else {
                                if (data != null) {
                                    var ss = data.split("|");
                                    if (ss[0] == "OK") {
                                        QueryUserInfo(ss[1]);
                                    } else {
                                        ClearUserDisplayInfo();
                                        //Messager.alert({
                                        //    title: '警告',
                                        //    content: data,
                                        //    timeout: 0  // 不自动关闭
                                        //});
                                        alert(data);
                                    }
                                }
                            }
                        });
                }
            }




            //显示用户相关信息
            function SetAndDisplayUserInfo(words) {
                var rts = $.parseJSON(words);
                $("#tbodyOrderList").empty();
                if (rts.UserInfo == null) {
                    //$("#lblInfo").html("银行卡号：" + rts.UserInfo.BankCardNo);
                    ClearUserDisplayInfo();
                } else {
                    var cardStaus = "";
                    if (rts.UserCard.cardflaga == "1") {
                        cardStaus = "正常";
                    } else if (rts.UserCard.cardflaga == "2") {
                        cardStaus = "挂失";
                    } else if (rts.UserCard.cardflaga == "3") {
                        cardStaus = "作废";
                    } else if (rts.UserCard.cardflaga == "4") {
                        cardStaus = "停用";
                    } else {
                        cardStaus = "异常";
                    }
                    var info = "你好, " + rts.UserInfo.FName + "<span class='label label-primary'>" + rts.UserInfo.CyName + "(" + rts.UserInfo.MonthStandard + ")" + "</span>您的账户信息如下：";
                    $("#userNameInfo").html(info);
                    var bankcardno = "";

                    $("#curMonthXFE").html(rts.UserInfo.Xiaofeimoney);
                    $("#okUseAllMoney").html(rts.UserInfo.OkUseAllMoney);
                    $("#xiaofeiYuE").html(rts.UserInfo.NoXiaofeimoney);
                    $("#accPoints").html(rts.UserInfo.AccPoints);
                    $("#xiaofeiPoints").html(rts.UserInfo.XiaoFeiPoints);
                    $("#amountC").html(rts.UserInfo.AmountC);
                    $("#amountB").html(rts.UserInfo.AmountB);
                    $("#amountA").html(rts.UserInfo.AmountA);
                    $("#djMoney").html(rts.UserInfo.dongjieMoney);
                    $("#bankTimeMoney").html(rts.bankTimeMoney);
                    //alert(rts.bankTimeMoney);
                    if (rts.bankTimeMoney != "") {
                        $("#trBankMoneyInfo").show();
                    } else {
                        $("#trBankMoneyInfo").hide();
                    }

                    //设定表单区的用户编号
                    $('#fm input[name="FCrimeCode"]').val(rts.UserInfo.FCode);
                    $('#fm input[name="FCrimeName"]').val(rts.UserInfo.FName);
                    $('#fm input[name="FAreaCode"]').val(rts.UserInfo.FAreaCode);

                    $.post("/DamagesMgr/GetRequestNowRecord", { "fcode": rts.UserInfo.FCode }, function (data) {
                        if (data.Flag) {
                            $('#editTypeId').val(data.DataInfo.TypeId);
                            $('#editUseMonths').val(data.DataInfo.UseMonths);
                            //时间戳转成时间
                            var strEndTime = '';
                            //时间戳转成时间
                            const timestamp = parseInt(data.DataInfo.EndTime.match(/\d+/), 10); // 提取时间戳 ‌:ml-citation{ref="3" data="citationList"}
                            const date = new Date(timestamp); // 创建日期对象 ‌:ml-citation{ref="1,2" data="citationList"}

                            var strEndTime = date.getFullYear() + "-" + String('0' + (date.getMonth() + 1)).slice(-2) + "-" + String('0' + date.getDate()).slice(-2);


                            $('#editEndTime').val(strEndTime);
                            $('#btnSubmitKK').attr("disabled", "disabled");
                            //$.messager.alert("提示", "已经有记录，无需重新申请");
                            if (data.DataInfo.Flag == 1) {
                                $("#topTitleDiv").html('<div class="alert alert-success" role="alert">记录状态：已审核</div>');
                            } else {
                                $("#topTitleDiv").html('<div class="alert alert-info" role="alert">记录状态：待审批</div>');
                            }
                            //Messager.alert({
                            //    title: '警告',
                            //    content: '已经有记录，无需重新申请！',
                            //    timeout: 0  // 不自动关闭
                            //});

                            alert('已经有记录，无需重新申请！');
                            //alert("已经有记录，无需重新申请");
                        } else {
                            $("#topTitleDiv").html('<h4>请选择申请条件 ：</h4 >');

                            $('#editTypeId').val("");
                            $('#editUseMonths').val("");
                            $('#editEndTime').val("");
                            $('#btnSubmitKK').removeAttr("disabled");
                        }
                    });
                }
            }

            function ClearUserDisplayInfo() {
                $("#userNameInfo").html("你好,用户信息不存在");
                $("#okUseAllMoney").html("0.00");
                $("#xiaofeiYuE").html("0.00");
                $("#accPoints").html("0.00");
                $("#amountC").html("0.00");
                $("#amountB").html("0.00");
                $("#amountA").html("0.00");

                //设定表单区的用户编号
                $('#fm input[name="FCrimeCode"]').val('');
                $('#fm input[name="FCrimeName"]').val('');
                $('#fm input[name="FAreaCode"]').val('');

                $("#topTitleDiv").html('<h4>请选择申请条件 ：</h4 >');
                $('#editTypeId').val("");
                $('#editUseMonths').val("");
                $('#editEndTime').val("");
                $('#btnSubmitKK').removeAttr("disabled");
            }


            //表单提交
            $('#fm').submit(function (e) {
                e.preventDefault();
                if ($('#fm input[name="FCrimeCode"]').val() == "" || $('#fm input[name="FCrimeCode"]').val() == undefined) {
                    //Messager.alert({
                    //    title: '警告',
                    //    content: '请先查询用户信息！',
                    //    timeout: 0  // 不自动关闭
                    //});

                    alert('请先查询用户信息！');
                    return false;
                }
                if ($("#editTypeId").find("option:selected").val() == "") {
                    //Messager.alert({
                    //    title: '警告',
                    //    content: '请先选择一个申请类型！',
                    //    timeout: 0  // 不自动关闭
                    //});

                    alert('请先选择一个申请类型');
                    return false;
                }

                if ($("#editUseMonths").find("option:selected").val() == "") {
                    //Messager.alert({
                    //    title: '警告',
                    //    content: '请先选择一个申请时长！',
                    //    timeout: 0  // 不自动关闭
                    //});

                    alert('请先选择一个申请时长！');

                    return false;
                }

                if ($("#editEndTime").val() == "") {
                    //Messager.alert({
                    //    title: '警告',
                    //    content: '请设定到期时间！',
                    //    timeout: 0  // 不自动关闭
                    //});

                    alert('请设定到期时间！');
                    return false;
                }



                $.ajax({
                    type: $(this).attr('method'),  // 获取表单 method 属性（如 POST）
                    url: $(this).attr('action'),    // 获取表单 action 属性（提交地址）
                    data: $(this).serialize(),      // 序列化表单数据
                    success: function (data) {
                        console.log('提交成功:', data);
                        //Messager.alert({
                        //    title: '提示',
                        //    content: data.ReMsg,
                        //    timeout: 0  // 不自动关闭
                        //});
                        alert(data.ReMsg);
                    },
                    error: function (xhr) {
                        console.error('提交失败:', xhr.statusText);
                    }
                });

            });



        </script>

